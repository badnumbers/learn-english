{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "COSMOS_CONNECTION_STRING": "AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=YOUR_KEY;",
    "COSMOS_DATABASE": "learn-english",
    "COSMOS_CONTAINER": "vocab",
    "MEDIA_BASE_URL": "https://YOUR_ACCOUNT.blob.core.windows.net",
    "MEDIA_IMAGES_CONTAINER": "images",
    "MEDIA_AUDIO_CONTAINER": "audio"
  },
  "Host": {
    "CORS": "*",
    "CORSCredentials": false
  }
}
